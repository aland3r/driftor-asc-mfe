{
  "name": "driftor-asc-mfe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Microfrontend do Driftor ASC: React, consome só o BFF pelo Azure API Management.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
